 public class SimplePromptCallback extends BiometricPrompt.AuthenticationCallback {
+    public interface TerminalListener {
+        void onTerminal(SimplePromptCallback callback);
+    }
+
     private Promise promise;
+    private final TerminalListener terminalListener;
+    private boolean terminal;

     public SimplePromptCallback(Promise promise) {
         super();
         this.promise = promise;
+        this.terminalListener = null;
+    }
+
+    public SimplePromptCallback() {
+        super();
+        this.promise = null;
+        this.terminalListener = null;
+    }
+
+    public SimplePromptCallback(TerminalListener terminalListener) {
+        super();
+        this.promise = null;
+        this.terminalListener = terminalListener;
+    }
+
+    public synchronized boolean setPromise(Promise promise) {
+        if (terminal || this.promise != null) {
+            return false;
+        }
+        this.promise = promise;
+        return true;
+    }
+
+    public void clearPromise(Promise promise) {
+        TerminalListener listener = null;
+        synchronized (this) {
+            if (!terminal && this.promise == promise) {
+                this.promise = null;
+                terminal = true;
+                listener = terminalListener;
+            }
+        }
+        if (listener != null) {
+            listener.onTerminal(this);
+        }
+    }
+
+    private Promise takePromise() {
+        Promise result;
+        TerminalListener listener;
+        synchronized (this) {
+            if (terminal) {
+                return null;
+            }
+            terminal = true;
+            result = promise;
+            promise = null;
+            listener = terminalListener;
+        }
+        if (listener != null) {
+            listener.onTerminal(this);
+        }
+        return result;
     }

