+
+static NSString *RNCWebViewResolveBuiltinScripts(NSArray<NSString *> *scriptIds)
+{
+  if (scriptIds == nil || scriptIds.count == 0) {
+    return nil;
+  }
+
+  NSMutableArray<NSString *> *parts = [NSMutableArray new];
+  for (id scriptId in scriptIds) {
+    if (![scriptId isKindOfClass:NSString.class]) {
+      continue;
+    }
+    NSString *source = RNCWebViewLoadBuiltinScript((NSString *)scriptId);
+    if (source.length > 0) {
+      [parts addObject:source];
+    }
+  }
+
+  return parts.count > 0 ? [parts componentsJoinedByString:@"\n"] : nil;
+}
+
+static NSString *RNCWebViewCombineScripts(NSArray<NSString *> *builtinScriptIds, NSString *source)
+{
+  NSMutableArray<NSString *> *parts = [NSMutableArray new];
+  NSString *builtinSource = RNCWebViewResolveBuiltinScripts(builtinScriptIds);
+  if (builtinSource.length > 0) {
+    [parts addObject:builtinSource];
+  }
+  if (source.length > 0) {
+    [parts addObject:source];
+  }
+
+  return parts.count > 0 ? [parts componentsJoinedByString:@"\n"] : nil;
+}
