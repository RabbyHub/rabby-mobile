+      urlObject.host,
+      urlObject.port ? [NSString stringWithFormat:@":%@", urlObject.port] : @""
+    ];
+
+    return baseURL.length ? [NSString stringWithFormat:@"Message from \n'%@'", baseURL] : @"Message from 3rd party";
+}
