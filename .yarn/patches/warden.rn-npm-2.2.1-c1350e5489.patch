new file mode 100644
index 0000000000000000000000000000000000000000..e7d8b2aaff9a0aeeff8504104fc2781b28092f7e
--- /dev/null
+++ b/test/persistent-graph.test.js
@@ -0,0 +1,120 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const test = require('node:test');
+const vm = require('node:vm');
+
+const { createWardenSerializer } = require('../dist');
+
+function makeHarness(t) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'warden-persistent-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const entryPath = path.join(root, 'node_modules/example/index.js');
+  const source = '__d(function(global, require, importDefault, importAll, module) { module.exports = { value: global.console.marker, maker: global.__mkGb }; });';
+  const originalOutput = {
+    type: 'js/module',
+    data: {
+      code: source,
+      functionMap: { names: ['example'], mappings: 'AAA' },
+      lineCount: 1,
+      map: [[1, 0, 1, 0]],
+    },
+  };
+  const originalModule = {
+    dependencies: new Map(),
+    getSource: () => Buffer.from(source),
+    inverseDependencies: new Set(),
+    output: [originalOutput],
+    path: entryPath,
+  };
+  const graph = {
+    dependencies: new Map([[entryPath, originalModule]]),
+    entryPoints: new Set([entryPath]),
+    transformOptions: { hot: false },
+  };
+  const serializer = createWardenSerializer(
+    (_entry, preModules, transformedGraph) => ({
+      code: [...preModules, ...transformedGraph.dependencies.values()]
+        .flatMap(module => module.output.map(output => output.data.code))
+        .join('\n'),
+      map: JSON.stringify(
+        [...transformedGraph.dependencies.values()].map(module =>
+          module.output.map(output => output.data.map),
+        ),
+      ),
+    }),
+    {
+      dev: false,
+      harden: false,
+      hardenDynamicCode: false,
+      protectModuleImports: false,
+      rootDir: './',
+      sourceRoot: './src',
+      policyDir: './Warden-RN',
+    },
+  );
+  const options = {
+    createModuleId: () => 0,
+    dev: false,
+    globalPrefix: '',
+    projectRoot: root,
+    shouldAddToIgnoreList: () => false,
+  };
+  return { entryPath, graph, options, originalModule, originalOutput, serializer };
+}
+
+function evaluate(code) {
+  const context = vm.createContext({ console: { marker: 'allowed' } });
+  vm.runInContext(`
+    function __d(factory) {
+      const module = { exports: {} };
+      factory(globalThis, undefined, undefined, undefined, module, module.exports);
+      globalThis.result = module.exports;
+    }
+    ${code}
+  `, context);
+  assert.equal(context.result.value, 'allowed');
+  // A fix must not expose the sandbox factory to protected module code.
+  assert.equal(context.result.maker, undefined);
+}
+
+test('release serialization leaves the caller graph, module, output and mappings untouched', async t => {
+  const harness = makeHarness(t);
+  const { originalModule, originalOutput } = harness;
+  const originalDependencies = harness.graph.dependencies;
+  const originalOutputs = originalModule.output;
+  const originalData = originalOutput.data;
+  const originalMap = originalData.map;
+  const originalFunctionMap = originalData.functionMap;
+  const originalBytes = JSON.stringify(originalOutput);
+
+  const result = await harness.serializer(
+    harness.entryPath, [], harness.graph, harness.options,
+  );
+
+  assert.strictEqual(harness.graph.dependencies, originalDependencies);
+  assert.strictEqual(harness.graph.dependencies.get(harness.entryPath), originalModule);
+  assert.strictEqual(originalModule.output, originalOutputs);
+  assert.strictEqual(originalOutputs[0], originalOutput);
+  assert.strictEqual(originalOutput.data, originalData);
+  assert.strictEqual(originalData.map, originalMap);
+  assert.strictEqual(originalData.functionMap, originalFunctionMap);
+  assert.equal(JSON.stringify(originalOutput), originalBytes);
+  evaluate(result.code);
+});
+
+test('repeated release requests against one persistent Metro graph remain executable and byte-identical', async t => {
+  const harness = makeHarness(t);
+  const first = await harness.serializer(
+    harness.entryPath, [], harness.graph, harness.options,
+  );
+  evaluate(first.code);
+
+  const second = await harness.serializer(
+    harness.entryPath, [], harness.graph, harness.options,
+  );
+  evaluate(second.code);
+  assert.equal(second.code, first.code);
+  assert.equal(second.map, first.map);
+});
