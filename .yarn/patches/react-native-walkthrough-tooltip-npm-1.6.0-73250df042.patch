+// Native headers can be close to any edge; fit the complete bubble, not just
+// its anchor. Keep arrow bases attached when moving the bubble into view.
+export const constrainGeometryToViewport = (geometry, options) => {
+  const { windowDims, displayInsets, contentSize, arrowSize } = options;
+  const { placement } = geometry;
+  const horizontal = placement === 'left' || placement === 'right';
+  const arrowExtent = horizontal ? arrowSize.width : arrowSize.height;
+  const left = displayInsets.left + (placement === 'right' ? arrowExtent : 0);
+  const top = displayInsets.top + (placement === 'bottom' ? arrowExtent : 0);
+  const right =
+    windowDims.width -
+    displayInsets.right -
+    (placement === 'left' ? arrowExtent : 0);
+  const bottom =
+    windowDims.height -
+    displayInsets.bottom -
+    (placement === 'top' ? arrowExtent : 0);
+  const width = Math.max(0, Math.min(contentSize.width, right - left));
+  const height = Math.max(0, Math.min(contentSize.height, bottom - top));
+  const clamp = (value, min, max) =>
+    Math.max(min, Math.min(Math.max(min, max), value));
+  const x = clamp(geometry.tooltipOrigin.x, left, right - width);
+  const y = clamp(geometry.tooltipOrigin.y, top, bottom - height);
+  const anchorPoint = new Point(geometry.anchorPoint.x, geometry.anchorPoint.y);
+  if (horizontal) {
+    anchorPoint.y = clamp(
+      anchorPoint.y,
+      y + arrowSize.height / 2,
+      y + height - arrowSize.height / 2,
+    );
+    anchorPoint.x =
+      placement === 'left' ? x + width + arrowExtent : x - arrowExtent;
+  } else if (placement !== 'center') {
+    anchorPoint.x = clamp(
+      anchorPoint.x,
+      x + arrowSize.width / 2,
+      x + width - arrowSize.width / 2,
+    );
+    anchorPoint.y =
+      placement === 'top' ? y + height + arrowExtent : y - arrowExtent;
+  }
+  return {
+    ...geometry,
+    tooltipOrigin: new Point(x, y),
+    adjustedContentSize: new Size(width, height),
+    anchorPoint,
+  };
+};
