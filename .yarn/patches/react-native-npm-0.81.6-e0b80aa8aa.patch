+ * handler is required. An omitted weight preserves a single-weight alias's weight.
+ */
+RCT_EXTERN UIFont *RCTFontWithSystemFontAlias(
+    NSString *family,
+    CGFloat size,
+    RCTFontWeight weight,
+    BOOL hasExplicitWeight,
+    BOOL italic,
+    BOOL condensed,
+    NSArray<NSDictionary *> *features);
