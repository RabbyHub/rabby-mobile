+// Rabby patch: see the dead modal guard comment at the top of this file.
+- (void)rabby_handleTapInModal:(UITapGestureRecognizer *)recognizer
+{
+  if (recognizer.state != UIGestureRecognizerStateRecognized || !_isPresented || !_shouldPresent) {
+    return;
+  }
+  RCTFabricModalHostViewController *viewController = _viewController;
+  if (!viewController || !viewController.view.window || viewController.isBeingPresented ||
+      viewController.isBeingDismissed) {
+    return;
+  }
+  if (RabbyViewHasVisibleContent(viewController.view, viewController.view, 0)) {
+    _rabbyDeadTapCount = 0;
+    return;
+  }
+
+  _rabbyDeadTapCount += 1;
+  if (_rabbyDeadTapCount == RabbyDeadModalStuckTapCount) {
+    // JS did not close it: the user is probably stuck behind this modal.
+    RCTLogWarn(
+        @"[Rabby] A presented Modal with no visible content is still blocking touches after %lu taps. "
+        @"Its onRequestClose did not hide it.",
+        (unsigned long)_rabbyDeadTapCount);
+    [[NSNotificationCenter defaultCenter] postNotificationName:@"RabbyModalHostDeadModalStuck" object:self];
+  }
+
+  auto eventEmitter = [self modalEventEmitter];
+  if (eventEmitter) {
+    eventEmitter->onRequestClose({});
+  }
+}
