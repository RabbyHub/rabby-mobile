-@interface RCTModalHostViewComponentView () <RCTFabricModalHostViewControllerDelegate>
+// Rabby patch: dead modal guard.
+//
+// A presented Modal blocks every touch on the screen below it. If it renders
+// nothing visible (no content, a fully transparent view, or an opacity-0
+// layer such as a tooltip that never finished measuring), the user sees the
+// app but cannot touch it, and there is nothing on screen to close it with.
+// When such a modal is tapped, ask JS to close it the way Android back or a
+// sheet swipe does (`onRequestClose`). Modals that show anything, and modals
+// that do not handle `onRequestClose`, behave exactly as before.
 
+static const NSUInteger RabbyDeadModalMaxDepth = 64;
+static const NSUInteger RabbyDeadModalStuckTapCount = 3;
+
+static BOOL RabbyColorIsVisible(CGColorRef color)
+{
+  return color != NULL && CGColorGetAlpha(color) >= 0.01;
+}
+
+// Whether the layer, or any of its sublayers that do not back a subview,
+// draws something.
+static BOOL RabbyLayerPaints(CALayer *layer, NSUInteger depth)
+{
+  if (depth > RabbyDeadModalMaxDepth) {
+    return YES;
+  }
+  if (layer.hidden || layer.opacity < 0.01) {
+    return NO;
+  }
+  if (layer.contents || RabbyColorIsVisible(layer.backgroundColor)) {
+    return YES;
+  }
+  if (layer.borderWidth > 0 && RabbyColorIsVisible(layer.borderColor)) {
+    return YES;
+  }
+  if (layer.shadowOpacity >= 0.01 && RabbyColorIsVisible(layer.shadowColor)) {
+    return YES;
+  }
+  if ([layer isKindOfClass:[CAShapeLayer class]]) {
+    CAShapeLayer *shape = (CAShapeLayer *)layer;
+    if (shape.path &&
+        (RabbyColorIsVisible(shape.fillColor) || (shape.lineWidth > 0 && RabbyColorIsVisible(shape.strokeColor)))) {
+      return YES;
+    }
+  } else if (![layer isMemberOfClass:[CALayer class]]) {
+    // Gradient, text, video, replicator and other special layers: assume they
+    // draw something.
+    return YES;
+  }
+  for (CALayer *sublayer in layer.sublayers) {
+    if ([sublayer.delegate isKindOfClass:[UIView class]]) {
+      // Checked together with its view.
+      continue;
+    }
+    if (RabbyLayerPaints(sublayer, depth + 1)) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+static BOOL RabbyViewHasVisibleContent(UIView *view, UIView *root, NSUInteger depth)
+{
+  if (depth > RabbyDeadModalMaxDepth) {
+    // Unusually deep: do not guess.
+    return YES;
+  }
+  if (view.hidden || view.alpha < 0.01) {
+    return NO;
+  }
+  if ([NSStringFromClass([view class]) hasPrefix:@"RCTDebuggingOverlay"]) {
+    // Dev-only React DevTools highlight layer. It draws nothing unless an
+    // element is being inspected.
+    return NO;
+  }
+
+  CGRect frameInRoot = [view convertRect:view.bounds toView:root];
+  BOOL isOnScreen = !CGRectIsEmpty(CGRectIntersection(frameInRoot, root.bounds));
+  if (isOnScreen) {
+    BOOL isPlainContainer = [view isMemberOfClass:[RCTViewComponentView class]] || [view isMemberOfClass:[UIView class]];
+    if (!isPlainContainer) {
+      // Text, images, inputs, native and third-party views: assume visible.
+      return YES;
+    }
+    if (RabbyLayerPaints(view.layer, 0)) {
+      return YES;
+    }
+  } else if (view.clipsToBounds) {
+    return NO;
+  }
+
+  for (UIView *subview in view.subviews) {
+    if (RabbyViewHasVisibleContent(subview, root, depth + 1)) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+@interface RCTModalHostViewComponentView () <RCTFabricModalHostViewControllerDelegate, UIGestureRecognizerDelegate>
+
 @property (nonatomic, weak) UIView *accessibilityFocusedView;
 
 @end
