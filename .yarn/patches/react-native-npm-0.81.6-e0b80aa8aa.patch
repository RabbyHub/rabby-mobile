+    return;
+  }
+  _rabbyIsPresentationPending = NO;
+  auto eventEmitter = [self modalEventEmitter];
+  if (eventEmitter) {
+    eventEmitter->onDismiss(ModalHostViewEventEmitter::OnDismiss{});
+  }
+}
