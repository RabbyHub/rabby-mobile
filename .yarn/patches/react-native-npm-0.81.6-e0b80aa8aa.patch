+    rabbyPullRefreshSamples.resize(kRabbyPullRefreshProbeCapacity);
+    rabbyPullRefreshReadIndex = 0;
+    rabbyPullRefreshCount = 0;
+    rabbyPullRefreshSequence = 0;
+    rabbyPullRefreshDropped = 0;
+    rabbyPullRefreshStartedMonotonicMs = nowMs;
+    rabbyPullRefreshStartedUnixMs = NSDate.date.timeIntervalSince1970 * 1000.0;
+    rabbyPullRefreshExpiresMonotonicMs = nowMs + fmin(durationMs, 300000.0);
+    rabbyPullRefreshRunId = [runId copy];
+    rabbyPullRefreshTarget = nil;
+    rabbyPullRefreshActive = true;
+    rabbyPullRefreshDisplayLink = [CADisplayLink displayLinkWithTarget:self
+                                                            selector:@selector(rabbyPullRefreshDisplayTick:)];
+    [rabbyPullRefreshDisplayLink addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
+    return RabbyPullRefreshProbeReply(@"started", @[]);
