+// Rabby patch: UIKit refuses to present a modal from a view controller that is
+// already presenting something (another Modal, a Tip, a native context menu, a
+// system sheet) or is mid-transition. Upstream still marks the modal as
+// presented, so its empty full-screen host view stays mounted and the screen
+// stops responding until the app restarts. Wait for the presenter to be free.
+- (void)rabby_schedulePresentRetry
+{
+  _rabbyIsPresentationPending = YES;
+  if (_rabbyIsPresentRetryScheduled) {
+    return;
+  }
+  _rabbyIsPresentRetryScheduled = YES;
+
+  __weak __typeof(self) weakSelf = self;
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+    __typeof(self) strongSelf = weakSelf;
+    if (!strongSelf) {
+      return;
+    }
+    strongSelf->_rabbyIsPresentRetryScheduled = NO;
+    [strongSelf ensurePresentedOnlyIfNeeded];
+  });
+}
+
+// Rabby patch: a modal that never reached the screen still has to report
+// onDismiss, or JS keeps its host mounted and never releases it.
