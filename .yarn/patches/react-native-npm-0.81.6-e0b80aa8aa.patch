diff --git a/React/Views/RCTFont.mm b/React/Views/RCTFont.mm
--- a/React/Views/RCTFont.mm
+++ b/React/Views/RCTFont.mm
@@ -10,6 +10,104 @@
 #import "RCTLog.h"
 
 #import <CoreText/CoreText.h>
+#import <objc/runtime.h>
+
+static char RCTSystemFontAliasKey;
+
+UIFont *RCTFontWithSystemFontAlias(
+    NSString *family,
+    CGFloat size,
+    RCTFontWeight weight,
+    BOOL hasExplicitWeight,
+    BOOL italic,
+    BOOL condensed,
+    NSArray<NSDictionary *> *features)
+{
+  static NSDictionary<NSString *, NSNumber *> *singleWeightAliases;
+  static NSCache<NSArray *, UIFont *> *baseFontCache;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    singleWeightAliases = @{
+      @"SFProRounded-Regular" : @(UIFontWeightRegular),
+      @"SFProRounded-Medium" : @(UIFontWeightMedium),
+      @"SFProRounded-Bold" : @(UIFontWeightBold),
+      @"SFProRounded-Heavy" : @(UIFontWeightHeavy),
+    };
+    baseFontCache = [NSCache new];
+    baseFontCache.countLimit = 256;
+  });
+
+  NSNumber *aliasWeight = family ? singleWeightAliases[family] : nil;
+  BOOL rounded = [family isEqualToString:@"SF Pro Rounded"] || aliasWeight != nil;
+  if (!rounded && ![family isEqualToString:@"SF Pro"]) {
+    return nil;
+  }
+
+  if (aliasWeight && !hasExplicitWeight) {
+    weight = aliasWeight.doubleValue;
+  }
+  if (rounded) {
+    // Match the four previously embedded fonts, rather than introducing new
+    // weights. In particular, Rabby's 900 means Heavy, not system Black.
+    const UIFontWeight availableWeights[] = {
+        UIFontWeightRegular, UIFontWeightMedium, UIFontWeightBold, UIFontWeightHeavy};
+    UIFontWeight closestWeight = availableWeights[0];
+    for (UIFontWeight candidate : availableWeights) {
+      if (fabs(candidate - weight) < fabs(closestWeight - weight)) {
+        closestWeight = candidate;
+      }
+    }
+    weight = closestWeight;
+  }
+
+  NSString *logicalFamily = rounded ? @"SF Pro Rounded" : @"SF Pro";
+  NSArray *cacheKey = @[logicalFamily, @(size), @(weight)];
+  UIFont *font = [baseFontCache objectForKey:cacheKey];
+  BOOL preservesRoundedDesign = rounded;
+  if (!font) {
+    font = [UIFont systemFontOfSize:size weight:weight];
+    if (rounded) {
+      UIFontDescriptor *descriptor =
+          [font.fontDescriptor fontDescriptorWithDesign:UIFontDescriptorSystemDesignRounded];
+      UIFont *roundedFont = descriptor ? [UIFont fontWithDescriptor:descriptor size:size] : nil;
+      preservesRoundedDesign = roundedFont != nil;
+      font = roundedFont ?: font;
+    }
+    if (!rounded || preservesRoundedDesign) {
+      [baseFontCache setObject:font forKey:cacheKey];
+    }
+  }
+
+  if (italic || condensed) {
+    UIFontDescriptorSymbolicTraits traits = font.fontDescriptor.symbolicTraits;
+    if (italic) {
+      traits |= UIFontDescriptorTraitItalic;
+    }
+    if (condensed) {
+      traits |= UIFontDescriptorTraitCondensed;
+    }
+    UIFontDescriptor *descriptor = [font.fontDescriptor fontDescriptorWithSymbolicTraits:traits];
+    if (descriptor) {
+      font = [UIFont fontWithDescriptor:descriptor size:size] ?: font;
+    }
+  }
+  if (features) {
+    UIFontDescriptor *descriptor = [font.fontDescriptor
+        fontDescriptorByAddingAttributes:@{UIFontDescriptorFeatureSettingsAttribute : features}];
+    font = [UIFont fontWithDescriptor:descriptor size:size] ?: font;
+  }
+
+  // UIFont.familyName is a system implementation detail. Keep the logical
+  // family on the final font, including trait/variant derivatives, so legacy
+  // updateFont:withSize:/withWeight: calls preserve the rounded design without
+  // recognizing private .SF family or PostScript names. Store the family, not
+  // a single-weight alias, so an explicit weight update survives later resizes.
+  // Do not mark shared default-system fonts, including a failed rounded-design fallback.
+  if (preservesRoundedDesign) {
+    objc_setAssociatedObject(font, &RCTSystemFontAliasKey, logicalFamily, OBJC_ASSOCIATION_RETAIN);
+  }
+  return font;
+}
 
