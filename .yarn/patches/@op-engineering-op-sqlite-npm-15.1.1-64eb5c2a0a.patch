+NativeSnapshotResult DBHostObject::executeNativeSnapshot(
+    const NativeSnapshotRequest &request) {
+  constexpr auto timeout = std::chrono::seconds(30);
+  constexpr auto maximumDelay = std::chrono::milliseconds(16);
+  auto delay = std::chrono::milliseconds(1);
+  const auto startedAt = std::chrono::steady_clock::now();
+
+  while (true) {
+    if (invalidated || db == nullptr) {
+      return {false, 0, "database connection is unavailable"};
+    }
+
+    try {
+      auto result = opsqlite::executeNativeSnapshot(db, request);
+      if (result.success ||
+          result.error != "native snapshot transaction is busy") {
+        return result;
+      }
+    } catch (...) {
+      return {false, 0, "native snapshot transaction failed"};
+    }
+
+    if (std::chrono::steady_clock::now() - startedAt >= timeout) {
+      return {false, 0, "native snapshot transaction wait timed out"};
+    }
+    std::this_thread::sleep_for(delay);
+    delay = std::min(delay * 2, maximumDelay);
+  }
+}
