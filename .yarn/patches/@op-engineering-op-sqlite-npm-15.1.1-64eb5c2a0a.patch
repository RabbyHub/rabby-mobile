diff --git a/cpp/NativeSnapshot.cpp b/cpp/NativeSnapshot.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..69a3b03bee6d406f0b374979b13ac74748286d6b
--- /dev/null
+++ b/cpp/NativeSnapshot.cpp
@@ -0,0 +1,348 @@
+#include "NativeSnapshot.h"
+
+#ifdef __ANDROID__
+#include "sqlite3.h"
+#else
+#include <sqlite3.h>
+#endif
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <set>
+#include <stdexcept>
+#include <utility>
+
+namespace opsqlite {
+namespace {
+
+constexpr std::uint8_t kMagic[] = {'R', 'A', 'S', '1'};
+constexpr std::uint32_t kMaximumRows = 1000000;
+constexpr std::uint32_t kMaximumColumns = 256;
+constexpr std::size_t kMaximumPayloadBytes = 256 * 1024 * 1024;
+constexpr std::size_t kMaximumStringBytes = 64 * 1024 * 1024;
+
+class DatabaseMutexGuard {
+public:
+  explicit DatabaseMutexGuard(sqlite3 *database)
+      : mutex_(sqlite3_db_mutex(database)) {
+    if (mutex_ != nullptr) {
+      sqlite3_mutex_enter(mutex_);
+    }
+  }
+
+  ~DatabaseMutexGuard() {
+    if (mutex_ != nullptr) {
+      sqlite3_mutex_leave(mutex_);
+    }
+  }
+
+private:
+  sqlite3_mutex *mutex_{nullptr};
+};
+
+class SnapshotReader {
+public:
+  explicit SnapshotReader(NativeSnapshotBytes input)
+      : input_(input.data), size_(input.size) {}
+
+  bool readHeader(std::uint32_t &columnCount, std::uint32_t &rowCount) {
+    if (input_ == nullptr || size_ > kMaximumPayloadBytes) {
+      return false;
+    }
+    for (const auto expected : kMagic) {
+      std::uint8_t actual = 0;
+      if (!readByte(actual) || actual != expected) {
+        return false;
+      }
+    }
+    return readUint32(columnCount) && columnCount > 0 &&
+        columnCount <= kMaximumColumns && readUint32(rowCount) &&
+        rowCount <= kMaximumRows;
+  }
+
+  bool bindRow(sqlite3_stmt *statement, std::uint32_t columnCount) {
+    sqlite3_clear_bindings(statement);
+    for (std::uint32_t index = 0; index < columnCount; ++index) {
+      std::uint8_t kind = 0;
+      if (!readByte(kind)) {
+        return false;
+      }
+      const auto parameterIndex = static_cast<int>(index + 1);
+      int status = SQLITE_ERROR;
+      switch (kind) {
+      case 0:
+        status = sqlite3_bind_null(statement, parameterIndex);
+        break;
+      case 1: {
+        const char *value = nullptr;
+        std::uint32_t length = 0;
+        if (!readString(value, length)) {
+          return false;
+        }
+        status = sqlite3_bind_text(
+            statement,
+            parameterIndex,
+            value,
+            static_cast<int>(length),
+            SQLITE_TRANSIENT);
+        break;
+      }
+      case 2: {
+        double value = 0;
+        if (!readDouble(value)) {
+          return false;
+        }
+        status = sqlite3_bind_double(statement, parameterIndex, value);
+        break;
+      }
+      case 3: {
+        std::int64_t value = 0;
+        if (!readInteger(value)) {
+          return false;
+        }
+        status = sqlite3_bind_int64(statement, parameterIndex, value);
+        break;
+      }
+      default:
+        return false;
+      }
+      if (status != SQLITE_OK) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  bool finished() const {
+    return position_ == size_;
+  }
+
+private:
+  bool readByte(std::uint8_t &value) {
+    if (position_ >= size_) {
+      return false;
+    }
+    value = input_[position_++];
+    return true;
+  }
+
+  bool readUint32(std::uint32_t &value) {
+    value = 0;
+    for (int shift = 0; shift < 32; shift += 8) {
+      std::uint8_t byte = 0;
+      if (!readByte(byte)) {
+        return false;
+      }
+      value |= static_cast<std::uint32_t>(byte) << shift;
+    }
+    return true;
+  }
+
+  bool readUint64(std::uint64_t &value) {
+    value = 0;
+    for (int shift = 0; shift < 64; shift += 8) {
+      std::uint8_t byte = 0;
+      if (!readByte(byte)) {
+        return false;
+      }
+      value |= static_cast<std::uint64_t>(byte) << shift;
+    }
+    return true;
+  }
+
+  bool readInteger(std::int64_t &value) {
+    std::uint64_t bits = 0;
+    if (!readUint64(bits)) {
+      return false;
+    }
+    std::memcpy(&value, &bits, sizeof(value));
+    return true;
+  }
+
+  bool readDouble(double &value) {
+    std::uint64_t bits = 0;
+    if (!readUint64(bits)) {
+      return false;
+    }
+    std::memcpy(&value, &bits, sizeof(value));
+    return std::isfinite(value);
+  }
+
+  bool readString(const char *&value, std::uint32_t &length) {
+    if (!readUint32(length) || length > kMaximumStringBytes ||
+        length > size_ - position_) {
+      return false;
+    }
+    value = reinterpret_cast<const char *>(input_ + position_);
+    position_ += length;
+    return true;
+  }
+
+  const std::uint8_t *input_{nullptr};
+  std::size_t size_{0};
+  std::size_t position_{0};
+};
+
+bool isValidIdentifier(const std::string &value) {
+  return !value.empty() &&
+      std::all_of(value.begin(), value.end(), [](unsigned char character) {
+        return std::isalnum(character) || character == '_';
+      });
+}
+
+bool executeSql(sqlite3 *database, const char *sql) {
+  return sqlite3_exec(database, sql, nullptr, nullptr, nullptr) == SQLITE_OK;
+}
+
+bool hasExpectedSchema(
+    sqlite3 *database,
+    const std::string &tableName,
+    const std::vector<std::string> &expectedColumns) {
+  const std::set<std::string> expectedColumnSet(
+      expectedColumns.begin(), expectedColumns.end());
+  if (!isValidIdentifier(tableName) || expectedColumns.empty() ||
+      expectedColumns.size() > kMaximumColumns ||
+      expectedColumnSet.size() != expectedColumns.size() ||
+      std::any_of(
+          expectedColumns.begin(), expectedColumns.end(),
+          [](const std::string &column) { return !isValidIdentifier(column); })) {
+    return false;
+  }
+  const auto sql = "PRAGMA table_info(\"" + tableName + "\")";
+  sqlite3_stmt *statement = nullptr;
+  if (sqlite3_prepare_v2(
+          database, sql.c_str(), -1, &statement, nullptr) != SQLITE_OK) {
+    return false;
+  }
+  std::set<std::string> actualColumns;
+  int status = SQLITE_ROW;
+  while ((status = sqlite3_step(statement)) == SQLITE_ROW) {
+    const auto *name = sqlite3_column_text(statement, 1);
+    const auto size = sqlite3_column_bytes(statement, 1);
+    if (name == nullptr || size <= 0) {
+      sqlite3_finalize(statement);
+      return false;
+    }
+    actualColumns.emplace(
+        reinterpret_cast<const char *>(name), static_cast<std::size_t>(size));
+  }
+  sqlite3_finalize(statement);
+  return status == SQLITE_DONE && actualColumns == expectedColumnSet;
+}
+
+bool executeRows(
+    sqlite3 *database,
+    const std::string &sql,
+    SnapshotReader &reader,
+    std::uint32_t expectedColumnCount,
+    std::uint32_t &rowCount) {
+  std::uint32_t columnCount = 0;
+  if (!reader.readHeader(columnCount, rowCount) ||
+      columnCount != expectedColumnCount) {
+    return false;
+  }
+  sqlite3_stmt *statement = nullptr;
+  if (sqlite3_prepare_v2(
+          database, sql.c_str(), -1, &statement, nullptr) != SQLITE_OK) {
+    return false;
+  }
+  bool success = true;
+  for (std::uint32_t index = 0; index < rowCount; ++index) {
+    if (!reader.bindRow(statement, columnCount) ||
+        sqlite3_step(statement) != SQLITE_DONE) {
+      success = false;
+      break;
+    }
+    if (index + 1 < rowCount && sqlite3_reset(statement) != SQLITE_OK) {
+      success = false;
+      break;
+    }
+  }
+  sqlite3_finalize(statement);
+  return success && reader.finished();
+}
+
+} // namespace
+
+NativeSnapshotResult executeNativeSnapshot(
+    sqlite3 *database, const NativeSnapshotRequest &request) {
+  NativeSnapshotResult result;
+  if (database == nullptr || request.expectedColumns.empty() ||
+      request.upsertSql.empty() || request.deleteSql.empty()) {
+    result.error = "native snapshot contract is unavailable";
+    return result;
+  }
+
+  DatabaseMutexGuard databaseGuard(database);
+  if (!hasExpectedSchema(
+          database, request.tableName, request.expectedColumns)) {
+    result.error = "native snapshot schema does not match";
+    return result;
+  }
+  if (sqlite3_get_autocommit(database) == 0) {
+    result.error = "native snapshot transaction is busy";
+    return result;
+  }
+  if (!executeSql(database, "BEGIN IMMEDIATE")) {
+    result.error = "native snapshot transaction could not begin";
+    return result;
+  }
+
+  SnapshotReader rowReader(request.rowPayload);
+  SnapshotReader deleteReader(request.deletePayload);
+  std::uint32_t rowCount = 0;
+  std::uint32_t deleteCount = 0;
+  bool success = executeRows(
+      database,
+      request.upsertSql,
+      rowReader,
+      static_cast<std::uint32_t>(request.expectedColumns.size()),
+      rowCount);
+  if (success) {
+    std::uint32_t deleteColumnCount = 0;
+    if (!deleteReader.readHeader(deleteColumnCount, deleteCount) ||
+        deleteColumnCount == 0) {
+      success = false;
+    } else {
+      sqlite3_stmt *statement = nullptr;
+      if (sqlite3_prepare_v2(
+              database,
+              request.deleteSql.c_str(),
+              -1,
+              &statement,
+              nullptr) != SQLITE_OK) {
+        success = false;
+      }
+      for (std::uint32_t index = 0; success && index < deleteCount; ++index) {
+        if (!deleteReader.bindRow(statement, deleteColumnCount) ||
+            sqlite3_step(statement) != SQLITE_DONE) {
+          success = false;
+          break;
+        }
+        if (index + 1 < deleteCount && sqlite3_reset(statement) != SQLITE_OK) {
+          success = false;
+        }
+      }
+      if (statement != nullptr) {
+        sqlite3_finalize(statement);
+      }
+      success = success && deleteCount > 0 && deleteReader.finished();
+    }
+  }
+
+  const auto shouldCommit = success && !request.rollbackOnly;
+  if (!executeSql(database, shouldCommit ? "COMMIT" : "ROLLBACK")) {
+    success = false;
+  }
+  result.success = success;
+  result.rowCount = success ? rowCount : 0;
+  if (!success) {
+    result.error = "native snapshot transaction failed";
+  }
+  return result;
+}
+
+} // namespace opsqlite
