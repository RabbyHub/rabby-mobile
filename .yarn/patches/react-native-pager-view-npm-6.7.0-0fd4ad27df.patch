+- (void)scrollViewDidEndDragging:(UIScrollView *)scrollView willDecelerate:(BOOL)decelerate {
+    // UIKit does not call didEndDecelerating when a drag stops at touch-up.
+    // Complete the state transition here so consumers can accept taps again.
