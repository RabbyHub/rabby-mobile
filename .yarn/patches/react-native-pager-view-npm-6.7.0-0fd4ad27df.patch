@@ -0,0 +1,39 @@
+cmake_minimum_required(VERSION 3.13)
+
+project(pagerview_offset_sampler)
+
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+add_library(
+    pagerview_offset_sampler
+    SHARED
+    cpp/PagerOffsetSampler.cpp
+)
+
+target_compile_options(
+    pagerview_offset_sampler
+    PRIVATE
+    -fexceptions
+    -frtti
+)
+
+# Reanimated ships its C++ headers with the npm package; including them is the
+# intended compile-time coupling for the UI-runtime bridge.
+target_include_directories(
+    pagerview_offset_sampler
+    PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/../../react-native-reanimated/Common/cpp
+)
+
+find_package(ReactAndroid REQUIRED CONFIG)
+find_package(fbjni REQUIRED CONFIG)
+
+target_link_libraries(
+    pagerview_offset_sampler
+    ReactAndroid::reactnative
+    ReactAndroid::jsi
+    fbjni::fbjni
+    android
+    log
+)
