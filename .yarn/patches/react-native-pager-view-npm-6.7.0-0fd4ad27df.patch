diff --git a/android/cpp/PagerOffsetSampler.cpp b/android/cpp/PagerOffsetSampler.cpp
new file mode 100644
index 0000000..ac50ed2
--- /dev/null
+++ b/android/cpp/PagerOffsetSampler.cpp
@@ -0,0 +1,127 @@
+// Dev-only (QA 1396) bridge: publish the pager offset that Android samples
+// every display frame into the Reanimated UI runtime.
+//
+// A worklet can only call host functions that exist on its own runtime, and
+// Reanimated exposes its UI runtime from the RN runtime global (the same
+// `__reanimatedModuleProxy` object it installs for its own decorators). So:
+//
+//   1. on the JS thread, resolve `__reanimatedModuleProxy` and grab its UI
+//      runtime,
+//   2. on the UI thread (the first sampled frame), install a `__pagerOffset`
+//      host function on that runtime.
+//
+// The Reanimated header is included deliberately: this is a compile-time
+// coupling. If an upgrade renames/removes the proxy accessor the build fails
+// instead of silently losing the sampling path at runtime.
+
+#include <jni.h>
+
+#include <atomic>
+
+#include <jsi/jsi.h>
+
+#include <reanimated/NativeModules/ReanimatedModuleProxy.h>
+
+namespace {
+
+using facebook::jsi::Function;
+using facebook::jsi::PropNameID;
+using facebook::jsi::Runtime;
+using facebook::jsi::Value;
+
+std::atomic<jlong> gUiRuntime{0};
+std::atomic<float> gPageOffset{0.0f};
+std::atomic<int> gPageCount{0};
+std::atomic<bool> gInstalled{false};
+
+void installGetter(Runtime &uiRuntime) {
+  auto getter = Function::createFromHostFunction(
+      uiRuntime,
+      PropNameID::forAscii(uiRuntime, "__pagerOffset"),
+      0,
+      [](Runtime &rt, const Value &, const Value *, size_t) -> Value {
+        return Value(static_cast<double>(
+            gPageOffset.load(std::memory_order_relaxed)));
+      });
+  uiRuntime.global().setProperty(uiRuntime, "__pagerOffset", std::move(getter));
+
+  // The sampler is process-wide, so a consumer needs to tell its own pager's
+  // offsets from an unrelated pager's.
+  auto pageCountGetter = Function::createFromHostFunction(
+      uiRuntime,
+      PropNameID::forAscii(uiRuntime, "__pagerOffsetPages"),
+      0,
+      [](Runtime &rt, const Value &, const Value *, size_t) -> Value {
+        return Value(static_cast<double>(
+            gPageCount.load(std::memory_order_relaxed)));
+      });
+  uiRuntime.global().setProperty(
+      uiRuntime, "__pagerOffsetPages", std::move(pageCountGetter));
+
+  gInstalled.store(true, std::memory_order_release);
+}
+
+// Must only run on the UI thread, which is where the sampler runs.
+void ensureInstalled() {
+  if (gInstalled.load(std::memory_order_acquire)) {
+    return;
+  }
+  const auto runtimePtr = gUiRuntime.load(std::memory_order_acquire);
+  if (runtimePtr == 0) {
+    return;
+  }
+  installGetter(*reinterpret_cast<Runtime *>(runtimePtr));
+}
+
+} // namespace
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_reactnativepagerview_PagerOffsetSampler_nativeBind(
+    JNIEnv *,
+    jobject,
+    jlong rnRuntimePtr) {
+  if (rnRuntimePtr == 0) {
+    return JNI_FALSE;
+  }
+  try {
+    auto &rnRuntime = *reinterpret_cast<Runtime *>(rnRuntimePtr);
+    auto proxyValue =
+        rnRuntime.global().getProperty(rnRuntime, "__reanimatedModuleProxy");
+    if (!proxyValue.isObject()) {
+      return JNI_FALSE;
+    }
+    auto proxyObject = proxyValue.getObject(rnRuntime);
+    if (!proxyObject.isHostObject<facebook::jsi::HostObject>(rnRuntime)) {
+      return JNI_FALSE;
+    }
+    auto hostObject = proxyObject.getHostObject<facebook::jsi::HostObject>(
+        rnRuntime);
+    auto *proxy =
+        static_cast<reanimated::ReanimatedModuleProxy *>(hostObject.get());
+    auto &uiRuntime = proxy->getUIRuntime();
+    gUiRuntime.store(
+        reinterpret_cast<jlong>(&uiRuntime), std::memory_order_release);
+    return JNI_TRUE;
+  } catch (...) {
+    // Reanimated is not ready yet; the JS interpolation fallback stays active.
+    return JNI_FALSE;
+  }
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_reactnativepagerview_PagerOffsetSampler_nativeEnsureInstalled(
+    JNIEnv *,
+    jobject) {
+  ensureInstalled();
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_reactnativepagerview_PagerOffsetSampler_nativePublishOffset(
+    JNIEnv *,
+    jobject,
+    jfloat pageOffset,
+    jint pageCount) {
+  gPageOffset.store(pageOffset, std::memory_order_relaxed);
+  gPageCount.store(pageCount, std::memory_order_relaxed);
+  ensureInstalled();
+}
