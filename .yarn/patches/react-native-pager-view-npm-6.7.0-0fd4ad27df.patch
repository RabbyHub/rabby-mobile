diff --git a/android/src/main/java/com/reactnativepagerview/PagerOffsetSampler.kt b/android/src/main/java/com/reactnativepagerview/PagerOffsetSampler.kt
new file mode 100644
index 0000000..6e608bb
--- /dev/null
+++ b/android/src/main/java/com/reactnativepagerview/PagerOffsetSampler.kt
@@ -0,0 +1,182 @@
+package com.reactnativepagerview
+
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import android.view.Choreographer
+import androidx.recyclerview.widget.RecyclerView
+import androidx.viewpager2.widget.ViewPager2
+import com.facebook.react.bridge.ReactContext
+import com.facebook.react.bridge.UiThreadUtil
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * Dev-only (QA 1396) bridge that publishes the real pager position at display
+ * rate instead of the ~60Hz `onPageScrolled` stream.
+ *
+ * `onPageScrolled` reaches JS at roughly 60Hz while the pager itself moves at
+ * the display rate, so a chrome driven from those samples advances in visible
+ * steps on a fast fling and can trail the page on the way back. A Choreographer
+ * frame callback reads `RecyclerView.computeHorizontalScrollOffset()` every
+ * display frame (measured 120Hz on a 120Hz panel) and hands the value to the
+ * Reanimated UI runtime, where a worklet can pull it without a JS-thread hop.
+ *
+ * The UI-runtime side lives in `cpp/PagerOffsetSampler.cpp`; it installs
+ * `global.__pagerOffset()` on the Reanimated UI runtime. Both halves are inert
+ * unless the `useNativePagerOffset` debug switch turns them on.
+ */
+internal object PagerOffsetSampler {
+  private const val LIB_NAME = "pagerview_offset_sampler"
+  private const val TAG = "PagerOffsetSampler"
+
+  private const val MAX_BIND_ATTEMPTS = 40
+  private const val BIND_RETRY_MS = 500L
+
+  private val loadAttempted = AtomicBoolean(false)
+  private val bindScheduled = AtomicBoolean(false)
+  private val bound = AtomicBoolean(false)
+  private val retryHandler = Handler(Looper.getMainLooper())
+
+  @Volatile private var loaded = false
+
+  private fun ensureLoaded(): Boolean {
+    if (loaded) return true
+    if (!loadAttempted.compareAndSet(false, true)) return loaded
+    try {
+      System.loadLibrary(LIB_NAME)
+      loaded = true
+    } catch (e: UnsatisfiedLinkError) {
+      // The bridge is optional: without it the JS interpolation fallback runs.
+      loaded = false
+    }
+    return loaded
+  }
+
+  /**
+   * Resolves the Reanimated UI runtime once. The RN runtime is only reachable
+   * from the JS thread, so the lookup is posted there; it is retried because a
+   * pager can be created before Reanimated has decorated the runtime.
+   */
+  fun bind(reactContext: ReactContext) {
+    if (bound.get() || !bindScheduled.compareAndSet(false, true)) return
+    attemptBind(reactContext, 1)
+  }
+
+  private fun attemptBind(reactContext: ReactContext, attempt: Int) {
+    if (bound.get()) return
+    val holder = reactContext.javaScriptContextHolder
+    val jsQueue = try {
+      reactContext.catalystInstance?.reactQueueConfiguration?.getJSQueueThread()
+    } catch (_: Throwable) {
+      null
+    }
+    if (holder == null || jsQueue == null) {
+      retry(reactContext, attempt)
+      return
+    }
+    try {
+      jsQueue.runOnQueue {
+        if (ensureLoaded()) {
+          val runtimePtr = synchronized(holder) { holder.get() }
+          if (runtimePtr != 0L && nativeBind(runtimePtr)) {
+            bound.set(true)
+            bindScheduled.set(false)
+            // Installing the UI-runtime getter must happen on the UI thread.
+            UiThreadUtil.runOnUiThread { nativeEnsureInstalled() }
+            Log.d(TAG, "bridge bound after attempt $attempt")
+            return@runOnQueue
+          }
+        }
+        Log.w(TAG, "bridge bind attempt $attempt failed")
+        retry(reactContext, attempt)
+      }
+    } catch (_: Throwable) {
+      retry(reactContext, attempt)
+    }
+  }
+
+  private fun retry(reactContext: ReactContext, attempt: Int) {
+    if (attempt >= MAX_BIND_ATTEMPTS) {
+      bindScheduled.set(false)
+      Log.w(TAG, "bridge bind gave up after $attempt attempts")
+      return
+    }
+    retryHandler.postDelayed(
+      { attemptBind(reactContext, attempt + 1) },
+      BIND_RETRY_MS,
+    )
+  }
+
+  /** Called on the UI thread, once per sampled display frame. */
+  fun publishOffset(pageOffset: Float, pageCount: Int) {
+    if (!ensureLoaded()) return
+    nativePublishOffset(pageOffset, pageCount)
+  }
+
+  private external fun nativeBind(rnRuntimePtr: Long): Boolean
+
+  private external fun nativeEnsureInstalled()
+
+  private external fun nativePublishOffset(pageOffset: Float, pageCount: Int)
+}
+
+/**
+ * Samples one pager while it is being dragged/settled (plus a couple of frames
+ * after it stops, so the settled value is exact). Idle pagers never publish, so
+ * several mounted pagers cannot fight over the shared UI-runtime value.
+ */
+internal class PagerFrameSampler(
+  private val viewPager: ViewPager2,
+) : Choreographer.FrameCallback {
+  companion object {
+    private const val SETTLE_FRAMES = 2
+  }
+
+  private val running = AtomicBoolean(false)
+  private var idleFrames = 0
+
+  @Volatile private var scrollState = ViewPager2.SCROLL_STATE_IDLE
+
+  fun start() {
+    if (running.compareAndSet(false, true)) {
+      Choreographer.getInstance().postFrameCallback(this)
+    }
+  }
+
+  fun stop() {
+    running.set(false)
+  }
+
+  fun onScrollStateChanged(state: Int) {
+    scrollState = state
+    if (state != ViewPager2.SCROLL_STATE_IDLE) {
+      idleFrames = 0
+      start()
+    }
+  }
+
+  override fun doFrame(frameTimeNanos: Long) {
+    if (!running.get()) return
+    if (scrollState == ViewPager2.SCROLL_STATE_IDLE) {
+      if (idleFrames >= SETTLE_FRAMES) {
+        running.set(false)
+        return
+      }
+      idleFrames++
+    } else {
+      idleFrames = 0
+    }
+    publishOffset()
+    Choreographer.getInstance().postFrameCallback(this)
+  }
+
+  private fun publishOffset() {
+    val recyclerView = viewPager.getChildAt(0) as? RecyclerView ?: return
+    val width = recyclerView.width
+    if (width <= 0) return
+    val offset = recyclerView.computeHorizontalScrollOffset().toFloat() / width
+    // The page count lets a consumer ignore offsets published by an unrelated
+    // pager (the value is process-wide, see PagerOffsetSampler).
+    PagerOffsetSampler.publishOffset(offset, viewPager.adapter?.itemCount ?: 0)
+  }
+}
