{
  "schemaVersion": 1,
  "methodPrefixes": {
    "query": ["get", "is", "has", "check", "verify", "estimate", "ping"],
    "command": [
      "set",
      "add",
      "remove",
      "update",
      "patch",
      "clear",
      "sync",
      "mark",
      "reset",
      "restore",
      "import",
      "sign",
      "create",
      "submit",
      "persist",
      "generate",
      "pin",
      "toggle",
      "enable",
      "disable",
      "lock",
      "unlock",
      "boot",
      "init",
      "ensure",
      "prepare",
      "request",
      "claim",
      "reject",
      "resolve",
      "call",
      "broadcast",
      "disconnect",
      "post",
      "complete",
      "dangerously"
    ],
    "subscription": [
      "subscribe",
      "unsubscribe",
      "addListener",
      "removeListener",
      "start",
      "stop",
      "watch",
      "unwatch"
    ]
  },
