{
  "name": "@rabby-wallet/react-native-bootsplash",
  "version": "7.3.2-rabby.0",
  "description": "Rabby-scoped runtime fork of react-native-bootsplash",
  "keywords": [
    "react-native-bootsplash",
    "react-native",
    "splash-screen",
    "launch-screen"
  ],
  "homepage": "https://github.com/zoontek/react-native-bootsplash",
  "repository": {
    "type": "git",
    "url": "https://github.com/RabbyHub/rabby-mobile.git"
  },
  "license": "MIT",
  "author": "Mathieu Acthernoene <zoontek@gmail.com>",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/typescript/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "require": {
        "types": "./dist/typescript/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/commonjs/index.d.ts",
  "files": [
    "dist",
    "android",
    "ios",
    "src",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!ios/build",
    "!ios/RNBootSplash.xcodeproj",
    "RNBootSplash.podspec",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "react-native-is-edge-to-edge": "^1.3.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "RNBootSplashSpec",
    "type": "modules",
    "jsSrcsDir": "./src/specs",
    "android": {
      "javaPackageName": "com.zoontek.rnbootsplash"
    }
  }
}
