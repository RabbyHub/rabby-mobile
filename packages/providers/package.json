{
  "name": "@rabby-wallet/universal-providers",
  "version": "14.0.2",
  "description": "A JavaScript Ethereum provider that connects to the wallet over a stream. Forked from @metamask/providers",
  "keywords": [
    "MetaMask",
    "Rabby",
    "Ethereum",
    "Provider"
  ],
  "homepage": "https://github.com/RabbyHub/rabby-mono/tree/main/packages/universal-providers#readme",
  "bugs": {
    "url": "https://github.com/RabbyHub/rabby-mono/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RabbyHub/rabby-mono.git"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:clean": "rimraf dist && yarn build",
    "build:docs": "typedoc",
    "lint": "yarn lint:eslint && yarn lint:misc --check && yarn lint:dependencies --check && yarn lint:changelog",
    "lint:changelog": "auto-changelog validate",
    "lint:dependencies": "depcheck && yarn dedupe",
    "lint:eslint": "eslint . --cache --ext js,ts",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write && yarn lint:dependencies && yarn lint:changelog",
    "lint:misc": "prettier '**/*.json' '**/*.md' '!CHANGELOG.md' '**/*.yml' '!.yarnrc.yml' --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "prepack": "./scripts/prepack.sh",
    "test": "jest && jest-it-up",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@metamask/json-rpc-engine": "7.3.1",
    "@metamask/rpc-errors": "6.1.0",
    "@metamask/safe-event-emitter": "3.0.0",
    "@metamask/utils": "8.2.1",
    "@rabby-wallet/object-multiplex": "workspace:^",
    "fast-deep-equal": "3.1.3",
    "is-stream": "2.0.1",
    "json-rpc-middleware-stream": "5.0.1",
    "readable-stream": "3.6.2"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "2.5.1",
    "@metamask/auto-changelog": "3.4.4",
    "@metamask/eslint-config": "11.1.0",
    "@metamask/eslint-config-jest": "11.1.0",
    "@metamask/eslint-config-nodejs": "11.1.0",
    "@metamask/eslint-config-typescript": "11.1.0",
    "@types/chrome": "0.0.233",
    "@types/jest": "28.1.8",
    "@types/node": "20.14.9",
    "@types/uuid": "9.0.7",
    "@types/webextension-polyfill": "0.10.7",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "depcheck": "1.4.7",
    "eslint": "8.56.0",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "27.6.2",
    "eslint-plugin-jsdoc": "39.9.1",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "4.2.1",
    "jest": "28.1.3",
    "jest-chrome": "0.7.2",
    "jest-environment-jsdom": "29.7.0",
    "jest-it-up": "2.2.0",
    "prettier": "2.8.8",
    "prettier-plugin-packagejson": "2.4.9",
    "rimraf": "3.0.2",
    "ts-jest": "28.0.8",
    "ts-node": "10.9.2",
    "typedoc": "0.23.28",
    "typescript": "5.7.3"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "authors": [
    "MetaMask",
    "Rabby"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "lavamoat": {
    "allowScripts": {}
  }
}
